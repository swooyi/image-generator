{
  "target_file": "zbll/*.json",
  "status_rule": "After completing a task, set its check field to true. In future runs, only tasks with check false are eligible for work.",
  "scope": "Convert the 472 ZBLL cases into seven OLL-family batch JSON files for the 3x3 image generator.",
  "assumptions": [
    "Each output item uses the source case name as filename and the source representative scramble as scramble.",
    "The seven OLL families are T, U, L, H, Pi, Sune, and Antisune."
  ],
  "source_checklists": [],
  "tasks": [
    {
      "id": "01_confirm_source_and_schema",
      "order": 1,
      "title": "Confirm source cases and batch schema",
      "check": true,
      "targets": "C:/dev/alg-note/alg/3x3/zbll/cases.json and src/app.bundle.js",
      "allowed_fields": [],
      "protected_fields": ["source files"],
      "summary": "Confirm the source grouping and the required filename/scramble batch fields.",
      "verify": ["Confirm 472 source cases across seven OLL families.", "Confirm the generator accepts a non-empty array of filename/scramble objects."]
    },
    {
      "id": "02_create_t_json",
      "order": 2,
      "title": "Create T batch JSON",
      "check": true,
      "targets": "zbll/zbll-t.json",
      "allowed_fields": ["filename", "scramble"],
      "protected_fields": ["source case data"],
      "summary": "Create the T-family batch file.",
      "verify": ["Parse JSON successfully.", "Confirm 72 unique T cases."]
    },
    {
      "id": "03_create_u_json",
      "order": 3,
      "title": "Create U batch JSON",
      "check": true,
